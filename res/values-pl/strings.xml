    <string name="cat_quests">Zadania i levelowanie</string>
    <string name="cat_ui">Interfejs</string>
    <string name="cat_combat">Walka i bossowie</string>
    <string name="cat_bags">Torby i przedmioty</string>
    <string name="cat_map">Mapa</string>
    <string name="cat_tools">Narzędzia</string>
    <string name="addon_dbm_dungeons">DBM: Lochy</string>
    <string name="addon_dbm_vanilla">DBM: Klasyczne rajdy</string>
    <string name="sum_questie">Pomocnik zadań: zadania, cele i NPC bezpośrednio na mapie, minimapie i w podpowiedziach. Niezbędny przy levelowaniu.</string>
    <string name="sum_rxp">Poradniki levelowania krok po kroku ze strzałką nawigacji i podpowiedziami, co robić dalej.</string>
    <string name="sum_bartender">Pełny zamiennik pasków akcji: rozmiar, położenie, widoczność i strony.</string>
    <string name="sum_dominos">Lekkie i elastyczne paski akcji, pasek rzucania i doświadczenia, obsługa Masque.</string>
    <string name="sum_moveany">Przesuwaj i skaluj prawie każdy element standardowego interfejsu.</string>
    <string name="sum_plater">Zaawansowane tabliczki z nazwami: zagrożenie, rzucane czary, aury, rozbudowane ustawienia i skrypty.</string>
    <string name="sum_threatplates">Tabliczki z nazwami pokazujące zagrożenie dla tanków i DPS, łatwe w konfiguracji.</string>
    <string name="sum_masque">Skórki dla przycisków akcji, toreb i wzmocnień. Działa z Dominos, Bartender i innymi.</string>
    <string name="sum_sexymap">Ładna, konfigurowalna minimapa: kształt, ramki, przyciski dodatków.</string>
    <string name="sum_mapster">Ulepszenia mapy świata: przezroczystość, skala, współrzędne, mgła wojny.</string>
    <string name="sum_bigwigs">Liczniki i ostrzeżenia dla bossów rajdowych. Lekka alternatywa dla DBM.</string>
    <string name="sum_dbm">Klasyczne liczniki i ostrzeżenia dla bossów. Rdzeń DBM.</string>
    <string name="sum_dbm_dungeons">Moduły DBM dla lochów, wyzwań i wydarzeń światowych (w tym Forever).</string>
    <string name="sum_dbm_vanilla">Moduły DBM dla klasycznych rajdów i światowych bossów Azeroth.</string>
    <string name="sum_capping">Liczniki pól bitewnych i aren: punkty do zdobycia, flagi, kolejka.</string>
    <string name="sum_tmw">Ikony czasów odnowienia, wzmocnień i osłabień według twoich reguł.</string>
    <string name="note_tmw">W walce Forever ukrywa część danych przed dodatkami, więc sortowanie i warunki odnowienia są tam ograniczone.</string>
    <string name="sum_musca">Port WeakAuras dla Forever: własne wskaźniki aur, odnowień i zasobów.</string>
    <string name="note_musca">Wyzwalacze dziennika walki nie działają w Forever, więc zaimportowane aury mogą wymagać poprawek.</string>
    <string name="sum_tullarange">Podświetla przyciski na czerwono, gdy cel jest poza zasięgiem, i na niebiesko, gdy brakuje many.</string>
    <string name="sum_betterbags">Jedna torba z automatycznymi kategoriami, wyszukiwaniem i sortowaniem.</string>
    <string name="sum_simpleilvl">Pokazuje poziom przedmiotu na ikonach w torbach, w ekwipunku i u kupców.</string>
    <string name="sum_canimogit">Oznacza przedmioty, których wyglądu nie masz jeszcze w kolekcji transmogryfikacji.</string>
    <string name="sum_silverdragon">Powiadamia o rzadkich potworach w pobliżu, pokazuje je na mapie i prowadzi historię.</string>
    <string name="sum_aio">Dostęp do ukrytych ustawień klienta (CVar) przez wygodne menu.</string>
    <string name="sum_broker">Zestaw wskaźników: złoto, FPS, opóźnienie, znajomi, gildia, wytrzymałość i wiele więcej.</string>
    <string name="sum_bugsack">Zbiera błędy Lua do „worka”, żeby nie przeszkadzały w grze.</string>
    <string name="note_bugsack">Błędy przechwytuje !BugGrabber, który znajdziesz na GitHubie lub WoWInterface.</string>

    <!-- Background auto-update (settings, detail panel, notifications) -->
