    <!-- Catalog -->
    <string name="cat_quests">Quests and leveling</string>
    <string name="cat_ui">Interface</string>
    <string name="cat_combat">Combat and bosses</string>
    <string name="cat_bags">Bags and items</string>
    <string name="cat_map">Map</string>
    <string name="cat_tools">Utilities</string>
    <string name="addon_dbm_dungeons">DBM: Dungeons</string>
    <string name="addon_dbm_vanilla">DBM: Classic raids</string>
    <string name="sum_questie">Quest helper: quests, objectives and NPCs right on the map, minimap and tooltips. A must-have for leveling.</string>
    <string name="sum_rxp">Step-by-step leveling guides with a navigation arrow and hints on what to do next.</string>
    <string name="sum_bartender">A full replacement for the action bars: size, position, visibility and paging.</string>
    <string name="sum_dominos">Light and flexible action bars, cast and XP bars, Masque support.</string>
    <string name="sum_moveany">Move and scale almost any element of the default interface.</string>
    <string name="sum_plater">Advanced nameplates: threat, casts, auras, deep settings and scripts.</string>
    <string name="sum_threatplates">Nameplates that show threat for tanks and DPS, easy to set up.</string>
    <string name="sum_masque">Skins for action buttons, bags and buffs. Works with Dominos, Bartender and others.</string>
    <string name="sum_sexymap">A good-looking, configurable minimap: shape, borders, addon buttons.</string>
    <string name="sum_mapster">World map improvements: transparency, scale, coordinates, fog of war.</string>
    <string name="sum_bigwigs">Raid boss timers and warnings. A light alternative to DBM.</string>
    <string name="sum_dbm">Classic boss timers and warnings. The DBM core.</string>
    <string name="sum_dbm_dungeons">DBM modules for dungeons, challenges and world events (Forever included).</string>
    <string name="sum_dbm_vanilla">DBM modules for the classic raids and the world bosses of Azeroth.</string>
    <string name="sum_capping">Battleground and arena timers: capture points, flags, queue.</string>
    <string name="sum_tmw">Icons for cooldowns, buffs and debuffs, by your own rules.</string>
    <string name="note_tmw">In combat Forever hides some data from addons, so sorting and cooldown conditions are limited there.</string>
    <string name="sum_musca">A WeakAuras port for Forever: your own indicators for auras, cooldowns and resources.</string>
    <string name="note_musca">Combat log triggers do not fire in Forever, so imported auras may need changes.</string>
    <string name="sum_tullarange">Colors buttons red when the target is out of range and blue when you lack mana.</string>
    <string name="sum_betterbags">One bag with automatic categories, search and sorting.</string>
    <string name="sum_simpleilvl">Shows item level on icons in bags, on your character and at vendors.</string>
    <string name="sum_canimogit">Marks items whose appearance you have not collected for transmog yet.</string>
    <string name="sum_silverdragon">Alerts you to rare mobs nearby, shows them on the map and keeps a history.</string>
    <string name="sum_aio">Access to hidden client settings (CVars) through a handy menu.</string>
    <string name="sum_broker">A set of info panels: gold, FPS, latency, friends, guild, durability and much more.</string>
    <string name="sum_bugsack">Collects Lua errors into a \"sack\" so they do not get in the way of play.</string>
    <string name="note_bugsack">Errors are caught by !BugGrabber, which you can find on GitHub or WoWInterface.</string>

